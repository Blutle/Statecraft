# Copy this file to .env and fill in your values. Never commit .env.

# Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=

# Your test server's ID (enable Developer Mode in Discord, then right-click the server -> Copy Server ID)
GUILD_ID=

# Discord user IDs allowed to run /admin commands, comma-separated (right-click yourself -> Copy User ID)
ADMIN_IDS=

# Game save file (the history log is written next to it)
GAME_FILE=game.json

# 1 = allow admin test tools (act as fake players, fast schedule). Set to 0 for real games.
TEST_MODE=1
