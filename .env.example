# Copy this file to .env and fill in your values. Never commit .env.

# Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=

# Your test server's ID (enable Developer Mode in Discord, then right-click the server -> Copy Server ID)
GUILD_ID=

# Discord user IDs allowed to run /admin commands, comma-separated (right-click yourself -> Copy User ID)
ADMIN_IDS=

# Game save file (the history log is written next to it)
GAME_FILE=game.json

# ---- Where Statecraft sits in the server (defaults suit a server of its own) ----
# top = Info first in the channel list; bottom = after everything else (for a shared server)
CATEGORY_PLACEMENT=top
# An existing channel (outside Statecraft) for /announce, or leave blank to give Statecraft its own #announcements
ANNOUNCEMENTS_CHANNEL=announcements
# 1 = game channels are visible only to players and jurors (Info stays visible so people can /join)
PLAYERS_ONLY=0

# ---- AI states (see AI_PLAYERS_PLAN.md). Leave OPENAI_API_KEY blank to turn them off. ----
# platform.openai.com -> API keys. Set a monthly spending limit there too, as a backstop.
OPENAI_API_KEY=
# Model name; the cheapest suitable one is chosen when the feature is wired up
AI_MODEL=
# USD per million tokens for AI_MODEL (input, output), from OpenAI's pricing page; used for the budgets below
AI_PRICE_IN=
AI_PRICE_OUT=
# Daily spending caps in USD (chat and gameplay polls are separate, so chat can't stop the AIs playing)
AI_DAILY_BUDGET_USD=2.00
AI_POLL_BUDGET_USD=0.50
# Messages each human can send to AI states per game day, and per minute (spam guard)
AI_CHAT_PER_PLAYER_DAY=1000
AI_CHAT_PER_MINUTE=6
# Longest AI reply, in tokens (about 3/4 of a word each), and messages remembered per correspondent
AI_MAX_REPLY_TOKENS=300
AI_HISTORY_MESSAGES=20

# 1 = allow admin test tools (act as fake players, fast schedule). Set to 0 for real games.
TEST_MODE=1
